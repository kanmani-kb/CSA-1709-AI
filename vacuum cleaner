# Vacuum Cleaner Problem

rooms = {
    'A': 'Dirty',
    'B': 'Dirty'
}

current = 'A'
cost = 0

print("Initial Room Status:")
print(rooms)

# Move from A to B
if current == 'A':
    print("\nVacuum cleaner is in Room A")
    print("Room A is dirty - Cleaning...")
    rooms['A'] = 'Clean'
    cost = cost + 1

    print("Moving from A to B")
    current = 'B'
    cost = cost + 1

# Clean Room B
if current == 'B':
    print("Vacuum cleaner is in Room B")
    print("Room B is dirty - Cleaning...")
    rooms['B'] = 'Clean'
    cost = cost + 1

print("\nFinal Room Status:")
print(rooms)

print("\nTotal Path Cost =", cost)
