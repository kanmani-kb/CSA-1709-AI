best_first(Start, Goal) :-
    search([[Start]], Goal, Path),
    reverse(Path, Result),
    write('Path: '),
    write(Result).

search([[Goal|Rest]|_], Goal, [Goal|Rest]).

search([Path|Paths], Goal, Result) :-
    Path = [Current|_],
    findall([Next|Path],
        (edge(Current, Next),
         \+ member(Next, Path)),
        NewPaths),
    append(Paths, NewPaths, AllPaths),
    sort_paths(AllPaths, Sorted),
    search(Sorted, Goal, Result).

sort_paths(Paths, Sorted) :-
    findall(H-P,
        (member(P, Paths),
         P = [Node|_],
         h(Node, H)),
        Pairs),
    keysort(Pairs, Ordered),
    remove_keys(Ordered, Sorted).

remove_keys([], []).
remove_keys([_-P|T], [P|R]) :-
    remove_keys(T, R).
