from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler
import numpy as np

X = np.array([
    [2, 4, 6],
    [3, 5, 7],
    [4, 6, 8],
    [5, 7, 9]
])

X_scaled = StandardScaler().fit_transform(X)

pca = PCA(n_components=2)
result = pca.fit_transform(X_scaled)

print("Reduced Data:")
print(result)
