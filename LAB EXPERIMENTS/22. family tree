
male(ram).
male(kumar).
male(arun).

female(sita).
female(priya).
female(anitha).

parent(ram, kumar).
parent(sita, kumar).
parent(kumar, arun).
parent(priya, arun).

father(X, Y) :-
    male(X),
    parent(X, Y).

mother(X, Y) :-
    female(X),
    parent(X, Y).

sibling(X, Y) :-
    parent(Z, X),
    parent(Z, Y),
    X \= Y.
